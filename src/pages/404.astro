---
import BaseLayout from "../layouts/BaseLayout.astro";
import SimpleHeader from "../components/SimpleHeader.astro";
import { SITE } from "../config/site.js";
---
<BaseLayout title={`Page not found | ${SITE.name}`} description="This page doesn't exist. Head back to the periodic table." noindex preloader={false}>
  <SimpleHeader />
  <main id="main" class="hub sheet ruled">
    <h1>Element 404 not found</h1>
    <p>That page has decayed, or it never existed. The table only goes up to 118 (for now).</p>
    <p><a class="btn" href="/">Back to the lab</a> <a class="btn" href="/elements/">Browse all elements</a></p>
  </main>
</BaseLayout>
