---
// Page shell shared by every route: fonts, global styles, SEO head, preloader, footer and the contact popup.
import "@fontsource/caveat/latin-500.css";
import "@fontsource/caveat/latin-700.css";
import "@fontsource/patrick-hand/latin-400.css";
import "@fontsource/courier-prime/latin-400.css";
import "@fontsource/courier-prime/latin-700.css";
import "../styles/global.css";
import "../styles/ui.css";
import SEO from "../components/SEO.astro";
import Preloader from "../components/Preloader.astro";
import ContactModal from "../components/ContactModal.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config/site.js";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  jsonLd?: object | object[];
  noindex?: boolean;
  element?: number;
  preloader?: boolean;
}
const { element, preloader = true, ...seo } = Astro.props;
---
<!doctype html>
<html lang={SITE.lang} data-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SEO {...seo} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <script is:inline>
      try { var t = localStorage.getItem("ptl:theme"); if (t && JSON.parse(t) === "chalk") document.documentElement.dataset.theme = "chalk"; } catch (e) {}
    </script>
    <noscript><style>.preloader { display: none !important; }</style></noscript>
  </head>
  <body data-element={element}>
    <a class="skip" href="#main">Skip to content</a>
    {preloader && <Preloader />}
    <div class="wrap">
      <slot />
      <Footer />
    </div>
    <slot name="overlays" />
    <ContactModal />
    <script>
      import "../scripts/tooltips.js";
    </script>
  </body>
</html>
