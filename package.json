{
  "name": "periodic-table-lab",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Periodic Table Lab: an interactive, paper-notebook periodic table with 3D and hand-drawn atom simulations.",
  "scripts": {
    "og": "node scripts/generate-og.mjs",
    "dev": "astro dev",
    "build": "node scripts/generate-og.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "setup:wasi": "npm install --force --no-save @bruits/satteri-wasm32-wasi@0.11.7 @astrojs/compiler-binding-wasm32-wasi@0.5.3",
    "start": "node --env-file=.env ./dist/server/entry.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "astro": "^7.4.12",
    "nodemailer": "^10.5.0",
    "three": "0.128.0"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
